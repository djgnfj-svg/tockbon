extends RefCounted
## 위치 해시 — 셀 시뮬의 **유일한** 난수원.
##
## 🔴 `randi()`를 쓰면 안 되는 이유: 그건 **스트림**이라 호출 횟수가 하나만 달라도
##  두 클라가 영원히 갈라지고, 재현도 안 된다. 위치 해시는 상태가 없어서
##  같은 격자·같은 틱이면 어느 기계에서든 같은 답이 나온다(설계 §4.3 · GDD 「멀티가 사는 조건」 3).
##
## 🔴 **정수 전용이다. 부동소수점을 확산 판정에 쓰지 마라.**
##
## ⚠ 곱수를 함부로 바꾸지 마라 — 전부 2^31 미만이라 `& M32`된 값과 곱해도
##  int64가 **넘치지 않는다**. 2^31 이상 곱수(예: 0x85EBCA6B)를 넣으면 오버플로가 나고,
##  그건 에러 없이 조용히 결정성을 깨는 자리다.

const M32 := 0xFFFFFFFF

const MUL_X := 0x1F123BB5  # 526611893
const MUL_Y := 0x27220A95  # 656442005
const MUL_T := 0x2545F491  # 626627217
const MUL_MIX := 0x045D9F3B  # 73244475


## 32비트 부호 없는 해시. x·y·tick·salt가 같으면 언제나 같은 값이다.
static func hash32(x: int, y: int, t: int, salt: int) -> int:
	var h: int = (x * MUL_X) & M32
	h = (h + ((y * MUL_Y) & M32)) & M32
	h = (h + (((t & M32) * MUL_T) & M32)) & M32
	h = (h + (salt & M32)) & M32
	h = (((h >> 16) ^ h) * MUL_MIX) & M32
	h = (((h >> 16) ^ h) * MUL_MIX) & M32
	h = ((h >> 16) ^ h) & M32
	return h
