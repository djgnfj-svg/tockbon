extends RefCounted
## 위력 단 표 — **조정 손잡이가 전부 여기 있다.**
##
## 🔴🔴 **한 파일 · 두 블록이다. 나누지 마라.**
##  나누면 단을 추가할 때 **한쪽만 늘어난다** — 그게 정확히 SKILL.md T8(축이 1→N인데 표시부가
##  뒤처진다)이고, **v1이 죽은 방식**이다(위력 78 → 157인데 총구·바닥 장식·섬광이 전부 고정).
##  ⇒ `test_spell_auto.gd`의 N8이 **두 블록의 길이와 단조성을 같이** 잰다. 한쪽만 늘리면 빨개진다.
##
## 🔴 **위 블록(SIM)은 결정론 계약이다** — 격자에 닿는다. 멀티에서 클라마다 다르면 세상이 갈라진다.
##  ⇒ 정수만. 아래 굵은 구분선의 블록 마커 사이를 N12가 **텍스트로** 스캔한다.
##  ⚠ **마커를 지우거나 늘리면 그물이 조용히 헛돈다.** N12가 「없다」와 「둘 이상이다」를 둘 다
##   실패로 친다 — 그래서 이 주석은 마커 문구를 **일부러 그대로 안 적는다**(적으면 그게 두 번째다).
## 🔴 **아래 블록(FX)은 화면에만 닿는다** — 클라마다 달라도 되고 사용자가 마음대로 때린다.
##
## ⚠ 반경 ×2(면적 ×4)는 **일부러 과장한 값이다.** 물리적으로는 에너지의 세제곱근이라 ×1.26이
##  맞지만, v1이 죽은 이유는 「과장」이 아니라 **「과소」**였다. 되돌리는 손잡이는 rd 세 칸뿐이다.

# ══════════════════════════════════════════════════════════════════
#  SIM-BLOCK-BEGIN — 🔴 여기부터 정수만. 격자에 닿는 것 전부.
# ══════════════════════════════════════════════════════════════════

const Mat := preload("res://src/world/cells/cell_materials.gd")

## 투사체 속도(셀/틱). 20틱 × 10셀 × 4px = 800px/s — 960px 화면을 1.2초에 가로지른다.
const SPEED_CELLS := 10

## 아무것도 안 맞은 투사체가 사라지는 틱 수.
## ⚠ **지금 격자(폭 256셀)에서는 도달 불가한 가드다** — 횡단이 26틱이라 격자 밖 소멸이 늘 먼저다.
##  그래도 뺄 수 없다: 튕김·유도·더 큰 격자 중 하나만 생겨도 영원히 도는 투사체가 된다.
const LIFETIME_TICKS := 40

## 동시 투사체. 32 × 2μs = 64μs/틱 = 예산의 0.4%. 여기는 병목이 아니다.
const MAX_PROJECTILES := 32

## 틱당 폭발. 🔴 **진짜 상한은 여기다** — 4 × P3(2.0ms) = 8.0ms = 프레임 예산의 48%.
## ⚠ 넘치는 폭발은 **버려지지 않고 다음 틱으로 밀린다**(큐가 순서를 지키므로 결정론적이다).
const MAX_BLASTS_PER_TICK := 4

# ─── 원소 ─────────────────────────────────────────────────────────
## 🔴 **새 재료도 새 플래그도 안 만든다.** 셀 시뮬에 **이미 있는 두 상태**(WET·CHARGED)로
##  「종류가 다른 결과」를 시연할 뿐이다 — GDD의 속성 목록은 아직 미정이라 여기서 정할 게 아니다.
const ELEM_WATER := 0
const ELEM_BOLT := 1

## 🔴 순회는 **반드시 이 명시 리스트로만** 한다. 값이 연속이라고 가정하면 나중에 은퇴한
##  자리가 생겼을 때 조용히 어긋난다(SKILL.md).
const ELEM_ALL: Array[int] = [ELEM_WATER, ELEM_BOLT]

## 🔴 잔여(`residue`)와 채우기(`fill`)가 원소가 세상에 남기는 전부다.
##  · WET은 **안 마른다** ⇒ 영구다. 그리고 다 쓰고 나면 청크가 즉시 잠들어 **상시 비용이 0**이다.
##  · CHARGED는 TTL 30틱짜리라 그동안 그 구역이 안 잠든다 — 영구성의 주축으로 삼으면
##    액체 리뷰 C1과 같은 병(안 잠드는 격자)이 재발한다.
## ⚠ 번개는 `fill`이 EMPTY다 = 채우기 패스를 아예 건너뛴다.
const ELEM_DEFS: Dictionary = {
	ELEM_WATER: {"residue": Mat.FLAG_WET, "fill": Mat.WATER},
	ELEM_BOLT: {"residue": Mat.FLAG_CHARGED, "fill": Mat.EMPTY},
}

const ELEM_NAMES: Dictionary = {ELEM_WATER: &"물", ELEM_BOLT: &"번개"}

# ─── 위력 단 ──────────────────────────────────────────────────────
## 🔴🔴 **단이 바뀌면 「크기」가 아니라 「종류」가 바뀐다.** 지형 타일이 16px = **4셀**이라
##  반경을 실제 두께에 맞춰 잡았다 — 사용자가 **이름을 붙일 수 있는 차이**여야 한다:
##
##    P1 (rd 6)  1타일 벽은 뚫는다 · **2타일은 못 뚫는다**   → 「긁는다」
##    P2 (rd 12) 3타일까지 뚫는다 · 관통 2로 벽 속에서 터진다 → 「문을 연다」
##    P3 (rd 24) 6타일 + 관통 6                              → 「방을 지운다」
##
## 🔴 **관통은 통과/불통이 갈리는 축이라 스칼라가 아니다** — P1은 벽 표면에서 터져 반원 자국을
##  남기고, P3는 **벽 속 6셀 지점에서** 터져 벽 안에 방을 만든다. N2가 이걸 잰다.
## ⚠ `rr > rd`가 아니면 잔여가 전부 EMPTY 위에 떨어져 **조용히 0이 된다**(N3이 지킨다).
const SIM_TIERS: Array[Dictionary] = [
	{"rd": 6, "rr": 9, "pierce": 0, "fill_r": 3},
	{"rd": 12, "rr": 18, "pierce": 2, "fill_r": 6},
	{"rd": 24, "rr": 36, "pierce": 6, "fill_r": 12},
]

# ══════════════════════════════════════════════════════════════════
#  SIM-BLOCK-END — 🔴 여기부터 화면 전용. float을 써도 된다.
# ══════════════════════════════════════════════════════════════════

## 🔴🔴 **이 블록은 B2(연출) 몫이다 — 값은 설계 §1.2 표를 그대로 옮겼고, 소비자는 아직 없다.**
##  자리를 미리 만들어 둔 이유가 T8이다: 단이 3개인데 연출이 P1만 반영하면 **그게 v1이다.**
##  N8이 SIM 블록과 **길이·단조성**을 같이 재므로, 단을 늘리고 여기를 잊으면 빨개진다.
##
## ⚠ **`_flag`·재료 id와 달리 여기 값은 계약이 아니다** — 클라마다 달라도 세상이 안 갈라진다.
##  사용자가 화면을 보고 직접 때려 조이는 손맛값이고, 그래서 `.tres`가 아니라 `const`가 맞다.
## ⚠ 흔들림은 **정수 px**로 써라(`snap_2d_transforms_to_pixel`이 켜져 있으면 소수부가 버려진다).
##  지속은 초가 아니라 **ms 정수**로 뒀다 — 그래야 N8의 단조 검사가 정수로 돈다.
const FX_TIERS: Array[Dictionary] = [
	{"flash_px": 54, "shake_px": 2, "shake_ms": 100, "trail_px": 4, "trail_ticks": 4, "sparks": 8},
	{"flash_px": 108, "shake_px": 5, "shake_ms": 200, "trail_px": 8, "trail_ticks": 6, "sparks": 16},
	{"flash_px": 216, "shake_px": 11, "shake_ms": 350, "trail_px": 12, "trail_ticks": 8, "sparks": 32},
]
