extends RefCounted
## 위력 단 표 — **조정 손잡이가 전부 여기 있다.**
##
## 🔴🔴 **한 파일 · 두 블록이다. 나누지 마라.**
##  나누면 단을 추가할 때 **한쪽만 늘어난다** — 그게 정확히 SKILL.md T8(축이 1→N인데 표시부가
##  뒤처진다)이고, **v1이 죽은 방식**이다(위력 78 → 157인데 총구·바닥 장식·섬광이 전부 고정).
##  ⇒ `test_spell_auto.gd`의 N8이 **두 블록의 길이와 단조성을 같이** 잰다. 한쪽만 늘리면 빨개진다.
##
## 🔴 **위 블록(SIM)은 결정론 계약이다** — 격자에 닿는다. 멀티에서 클라마다 다르면 세상이 갈라진다.
##  ⇒ 정수만. 아래 굵은 구분선의 블록 마커 사이를 N12가 **텍스트로** 스캔한다.
##  ⚠ **마커를 지우거나 늘리면 그물이 조용히 헛돈다.** N12가 「없다」와 「둘 이상이다」를 둘 다
##   실패로 친다 — 그래서 이 주석은 마커 문구를 **일부러 그대로 안 적는다**(적으면 그게 두 번째다).
## 🔴 **아래 블록(FX)은 화면에만 닿는다** — 클라마다 달라도 되고 사용자가 마음대로 때린다.
##
## ⚠ 반경 ×2(면적 ×4)는 **일부러 과장한 값이다.** 물리적으로는 에너지의 세제곱근이라 ×1.26이
##  맞지만, v1이 죽은 이유는 「과장」이 아니라 **「과소」**였다. 되돌리는 손잡이는 rd 세 칸뿐이다.
##
## 🔴🔴 **손잡이가 몇 개인지 정직하게 세라 — 설계는 「축 8개 · 영구 4개」로 셌는데 과다 계상이었다.**
##  `SIM_TIERS`의 네 값 중 **셋이 `rd` 하나의 파생**이다: `rr = 1.5×rd` · `fill_r = 0.5×rd`가
##  세 단 모두 **정확히** 성립한다. ⇒ 실제 손잡이는 이렇다:
##
##    위력   `rd`(구멍·잔여·물이 한꺼번에 따라온다) · `pierce`(통과/불통이 갈린다)   ← 둘
##    종류   원소(`ELEM_DEFS`)                                                      ← 하나
##
##  🔴 **규칙이 틀린 게 아니다** — 위력=세기, 종류=원소라는 분업은 그대로 유효하고, 반경이 지형
##   두께 문턱(4셀)을 넘나들며 「긁는다/문을 연다/방을 지운다」가 되는 논증도 유효하다.
##   **틀린 건 세는 법이었고, 그게 그물에 흔적을 남겼다**: N1과 N3은 독립 그물이 아니다
##   (`rr`가 `rd`에 하드링크라 N1이 그린이면 N3의 비도 자동으로 그린이다).
##  ⚠ **「P3가 P2보다 크기만 하다」는 답이 나오면 반경을 더 키우는 게 답이 아니다** —
##   남은 레버는 `pierce`를 `rd`에서 떼는 것이다(설계 §7.5-4의 「터널」이 이미 그 답을 적어 뒀다).

# ══════════════════════════════════════════════════════════════════
#  SIM-BLOCK-BEGIN — 🔴 여기부터 정수만. 격자에 닿는 것 전부.
# ══════════════════════════════════════════════════════════════════

const Mat := preload("res://src/world/cells/cell_materials.gd")

## 투사체 속도(셀/틱). 20틱 × 10셀 × 4px = 800px/s — 960px 화면을 1.2초에 가로지른다.
const SPEED_CELLS := 10

## 아무것도 안 맞은 투사체가 사라지는 틱 수.
## ⚠ **지금 격자에서는 도달 불가한 가드다** — 격자 횡단이 더 짧아 격자 밖 소멸이 늘 먼저다.
##  그래도 뺄 수 없다: 튕김·유도·더 큰 격자 중 하나만 생겨도 영원히 도는 투사체가 된다.
## 🔴 **횡단 틱 수를 여기 숫자로 박지 마라** — N7d가 격자 폭과 속도에서 파생해 계산하고,
##  손으로 적은 숫자는 둘 중 하나가 바뀌는 순간 조용히 낡는다(실제로 26 vs 27로 어긋나 있었다).
const LIFETIME_TICKS := 40

## 동시 투사체. 32 × 2μs = 64μs/틱 = 예산의 0.4%. 여기는 병목이 아니다.
const MAX_PROJECTILES := 32

## 틱당 폭발. 🔴 **진짜 상한은 여기다** — 실측으로 P3 물 4발 동시 적용이 **8,940μs = 예산의 54%**다
##  (설계 추정 8.0ms / 48%보다 크다). 투사체 32발 상한은 0.4%라 병목이 아니다.
## ⚠ 넘치는 폭발은 **버려지지 않고 다음 틱으로 밀린다**(N7g가 그 자리다). 밀림 순서는 발사 순이
##  아니라 슬롯 순이지만 결정론적이다.
const MAX_BLASTS_PER_TICK := 4

# ─── 원소 ─────────────────────────────────────────────────────────
## 🔴 **새 재료도 새 플래그도 안 만든다.** 셀 시뮬에 **이미 있는 두 상태**(WET·CHARGED)로
##  「종류가 다른 결과」를 시연할 뿐이다 — GDD의 속성 목록은 아직 미정이라 여기서 정할 게 아니다.
const ELEM_WATER := 0
const ELEM_BOLT := 1

## 🔴 순회는 **반드시 이 명시 리스트로만** 한다. 값이 연속이라고 가정하면 나중에 은퇴한
##  자리가 생겼을 때 조용히 어긋난다(SKILL.md).
const ELEM_ALL: Array[int] = [ELEM_WATER, ELEM_BOLT]

## 🔴 잔여(`residue`)와 채우기(`fill`)가 원소가 세상에 남기는 전부다.
##  · WET은 **안 마른다** ⇒ 영구다. 그리고 다 쓰고 나면 청크가 즉시 잠들어 **상시 비용이 0**이다.
##  · CHARGED는 TTL 30틱짜리라 그동안 그 구역이 안 잠든다 — 영구성의 주축으로 삼으면
##    액체 리뷰 C1과 같은 병(안 잠드는 격자)이 재발한다.
## ⚠ 번개는 `fill`이 EMPTY다 = 채우기 패스를 아예 건너뛴다.
const ELEM_DEFS: Dictionary = {
	ELEM_WATER: {"residue": Mat.FLAG_WET, "fill": Mat.WATER},
	ELEM_BOLT: {"residue": Mat.FLAG_CHARGED, "fill": Mat.EMPTY},
}

const ELEM_NAMES: Dictionary = {ELEM_WATER: &"물", ELEM_BOLT: &"번개"}

# ─── 위력 단 ──────────────────────────────────────────────────────
## 🔴🔴 **단이 바뀌면 「크기」가 아니라 「종류」가 바뀐다.** 지형 타일이 16px = **4셀**이라
##  반경을 실제 두께에 맞춰 잡았다 — 사용자가 **이름을 붙일 수 있는 차이**여야 한다:
##
##    P1 (rd 6)  1타일 벽은 뚫는다 · **2타일은 못 뚫는다**   → 「긁는다」
##    P2 (rd 12) 3타일까지 뚫는다 · 관통 2로 벽 속에서 터진다 → 「문을 연다」
##    P3 (rd 24) 6타일 + 관통 6                              → 「방을 지운다」
##
## 🔴 **관통은 통과/불통이 갈리는 축이라 스칼라가 아니다** — P1은 벽 표면에서 터져 반원 자국을
##  남기고, P3는 **벽 속 6셀 지점에서** 터져 벽 안에 방을 만든다. N2가 이걸 잰다.
## ⚠ `rr > rd`가 아니면 잔여가 전부 EMPTY 위에 떨어져 **조용히 0이 된다.**
##  N3이 표를 재고, `CellGrid._blast`가 커맨드 경계에서 런타임으로도 막는다(리뷰 M5).
const SIM_TIERS: Array[Dictionary] = [
	{"rd": 6, "rr": 9, "pierce": 0, "fill_r": 3},
	{"rd": 12, "rr": 18, "pierce": 2, "fill_r": 6},
	{"rd": 24, "rr": 36, "pierce": 6, "fill_r": 12},
]

# ══════════════════════════════════════════════════════════════════
#  SIM-BLOCK-END — 🔴 여기부터 화면 전용. float을 써도 된다.
# ══════════════════════════════════════════════════════════════════

## 🔴🔴 **여기가 「강한 마법이 세게 보이나」의 화면 쪽 절반 전부다.**
##  자리를 미리 만들어 둔 이유가 T8이다: 단이 3개인데 연출이 P1만 반영하면 **그게 v1이다.**
##  N8이 SIM 블록과 **길이·단조성**을 같이 재고, `test_spell_fx_auto.gd`의 X1이 **여기 축 하나하나가
##  실제로 렌더 소스에서 읽히는지**를 잰다 — 축만 늘리고 소비자를 안 만들면 거짓 손잡이다(T3).
##
## ⚠ **`_flag`·재료 id와 달리 여기 값은 계약이 아니다** — 클라마다 달라도 세상이 안 갈라진다.
##  사용자가 화면을 보고 직접 때려 조이는 손맛값이고, 그래서 `.tres`가 아니라 `const`가 맞다.
## ⚠ 흔들림은 **정수 px**로 써라(`snap_2d_transforms_to_pixel`이 켜져 있으면 소수부가 버려진다).
##  지속은 초가 아니라 **ms 정수**로 뒀다 — 그래야 N8의 단조 검사가 정수로 돈다.
## 🔴 **모든 필드는 단마다 「반드시 증가」해야 한다**(N8). 한 축을 끄고 싶으면 값을 같게 두지 말고
##  소비자 쪽에서 상수를 곱해라 — 같은 값을 두면 그물이 「깜빡했다」와 구별을 못 한다.
##
##   flash_px    폭발 섬광의 최종 반경(px)
##   flash_ms    섬광·스파크가 사는 시간(ms). 🔴 히트스톱을 뺀 대가를 여기서 갚는다(설계 §8)
##   shake_px    화면 흔들림 진폭(정수 px) · shake_ms  그 지속(ms)
##   trail_px    자취 굵기(px) · trail_ticks  자취가 기억하는 틱 수(= 꼬리 길이)
##   sparks      방사 스파크 개수 · spark_px  스파크 비거리(px)
##   bolt_px     🔴 **투사체 머리 반경(px).** 날아가는 0.3초 동안 단이 눈에 보이는 유일한 축이다
const FX_TIERS: Array[Dictionary] = [
	{
		"flash_px": 54, "flash_ms": 140, "shake_px": 2, "shake_ms": 100,
		"trail_px": 4, "trail_ticks": 4, "sparks": 8, "spark_px": 24, "bolt_px": 3,
	},
	{
		"flash_px": 108, "flash_ms": 210, "shake_px": 5, "shake_ms": 200,
		"trail_px": 8, "trail_ticks": 6, "sparks": 16, "spark_px": 56, "bolt_px": 5,
	},
	{
		"flash_px": 216, "flash_ms": 320, "shake_px": 11, "shake_ms": 350,
		"trail_px": 12, "trail_ticks": 8, "sparks": 32, "spark_px": 128, "bolt_px": 8,
	},
]

## 원소가 화면에서 갈리는 자리. 🔴 **단은 「얼마나 큰가」를, 원소는 「무슨 색인가」를 맡는다** —
##  둘을 한 축에 섞으면 사용자가 무엇이 커진 건지 못 읽는다.
## ⚠ 렌더가 **가산 합성**(BLEND_MODE_ADD)이라 알파는 밝기로 읽힌다. 1.0을 넘길 필요가 없다.
const ELEM_FX: Dictionary = {
	ELEM_WATER: {"core": Color(0.72, 0.94, 1.0), "glow": Color(0.20, 0.52, 1.0)},
	ELEM_BOLT: {"core": Color(1.0, 0.97, 0.74), "glow": Color(1.0, 0.70, 0.14)},
}

## 정의가 없는 원소의 색. 🔴 **일부러 마젠타다** — 원소를 늘렸는데 여기를 안 늘리면
##  화면이 비명을 지른다(`cell_materials.gd`의 `MISSING_COLOR`와 같은 이유).
const ELEM_FX_MISSING: Dictionary = {
	"core": Color(1.0, 0.0, 1.0), "glow": Color(1.0, 0.0, 1.0),
}

# ─── 손맛 손잡이 ──────────────────────────────────────────────────
## 🔴🔴 **여기 말고 다른 데에 연출 상수를 두지 마라.** 흩어지면 사용자가 튜닝을 못 한다.
##  위 표가 「단마다 다른 것」이고, 아래가 「단과 무관하게 전부에 걸리는 것」이다.

## 동시 섬광 수 상한. 넘치면 **가장 오래된 것부터** 버린다.
##
## ⚠ **잘림이 「수명 직전」이 아니다 — 실제로는 62% 지점이다.** 틱당 4발이 계속 터지면
##  16 / 4 = **4틱 = 0.2초**에서 잘리는데 P3 섬광 수명이 0.32초다. 그때 밝기가 `(1−0.62)² ≈ 0.14`라
##  **흐릿하지만 아직 보이는 상태에서 사라진다.** 눈에 띄면 24로 올려라.
##
## 🔴🔴 **프레임이 무너질 때 먼저 내릴 것도 `sparks`가 아니라 여기다.** 이유가 「지저분함」이 아니다:
##  최악 프레임의 드로우는 선 ~736개 + 원 ~98개인데, **무게중심은 선이 아니라 큰 반경 원이다.**
##  P3 섬광 겉무리는 **r = 216px**(지름 432px)이고 그게 16장 겹치며 전부 가산 합성이라
##  **블렌드 오버드로**가 그대로 쌓인다. 선 736개는 얇아서 픽셀 수가 훨씬 적다.
##  ⚠ **헤드리스는 그리지 않아 이걸 원리적으로 못 잰다.** `_tick_usec`도 시뮬 전용이라 안 포함한다 —
##   「틱 μs는 멀쩡한데 FPS가 떨어진다」가 나오면 그게 이 자리다. HUD의 FPS가 유일한 계기다.
const FX_MAX := 16

## 🔴 1px 미만은 안 그린다. **렌더 하한이라 손맛값이 아니다** — 세 군데(자취·스파크·꼬리)가
##  같은 뜻의 매직넘버를 각자 들고 있으면 반드시 갈라진다(T5).
const MIN_DRAW_PX := 1.0

## 섬광이 **뜨는 순간의 크기**(최종 반경 대비). 작을수록 「퍼진다」, 1에 가까울수록 「번쩍한다」.
const FLASH_START := 0.35
## 겉 무리 밝기 · 속심 반경 비율. 속심이 「하얗게 타는 심지」다.
const FLASH_GLOW_A := 0.55
const FLASH_CORE_RATIO := 0.34

## 스파크 꼬리 길이(비거리 대비) · 방사 방향 지터(라디안) · 비거리 하한 배수.
## ⚠ `SPARK_SPREAD`를 0으로 두면 완벽한 방사형이라 **폭죽이 아니라 도표처럼 보인다.**
const SPARK_TAIL := 0.45
const SPARK_SPREAD := 0.55
const SPARK_SPEED_MIN := 0.55
## 스파크 굵기 = `trail_px` × 이것. 자취와 같은 표를 쓰는 게 「같은 마법에서 나온 것」으로 읽힌다.
const SPARK_WIDTH_RATIO := 0.4

## 자취 꼬리의 알파(머리 쪽이 1.0). 0에 가까울수록 뾰족하게 사라진다.
const TRAIL_TAIL_A := 0.15

## 🔴🔴 **착탄 줄기** — 투사체가 착탄점에 도달하는 그림을 메운다.
##  시뮬이 투사체를 **터진 그 틱에 제거**해서, 마지막으로 그려진 머리는 착탄 셀보다 최대 한 틱
##  (≈40px) 뒤에 있고 섬광은 착탄 셀에 뜬다. ⇒ 화면에서 **「탄이 벽에 닿기 직전에 사라지고
##  그 앞쪽에서 터진다」**로 나온다. 16ms짜리지만 **재는 것이 정확히 「착탄이 세게 보이나」다.**
## ⚠ 시뮬을 안 건드리고 화면에서만 잇는다 — 폭발 이벤트의 착탄 셀과 그 투사체의 마지막 자취점을
##  선으로 이으면 끝이다. 0으로 두면 줄기가 안 그려지고 예전 그림으로 돌아간다.
const STREAK_FRAC := 0.4
const STREAK_WIDTH_RATIO := 0.9

## 투사체 겉 무리 = `bolt_px` × 이것.
const BOLT_GLOW_RATIO := 2.4
const BOLT_GLOW_A := 0.45

## 총구. 🔴 **v1이 죽은 항목 중 하나가 「총구가 위력을 안 따라간다」였다.**
##  ⇒ 쏘기 전에도 총구 무리가 `bolt_px`로 커진다 — **고른 위력이 화면에 미리 보인다.**
##  ⚠ 이 프로토타입엔 캐릭터가 없어 총구가 고정점(중클릭)이다. 캐릭터가 생기면 그 손으로 옮겨라.
