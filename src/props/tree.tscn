[gd_scene load_steps=3 format=3 uid="uid://c0prop07tree00"]

[ext_resource type="Script" path="res://src/props/tree.gd" id="1_tree"]

; 🔴 세99 「나무 뒤로 가면 비친다」의 감지 상자 — **나무 밑동(노드 원점) 위쪽 그늘**만 덮는다.
; 아래로 안 내리는 게 계약이다: 밑동보다 **아래**에 선 플레이어는 나무 **앞**이라 가릴 이유가 없다
; (그때 나무는 z 0으로 남아 원래대로 플레이어 뒤에 그려진다).
; 폭 88 = 가장 넓은 그림(tree_round 116)보다 좁고 가장 좁은 것(tree_pine 78)보다 넓다 — 세 변형이
; 랜덤으로 붙으므로 하나에 딱 맞추면 나머지 둘이 어긋난다.
; ⚠ 세100에 나무를 128px로 다시 그리며 **가장 좁은 것이 dead에서 pine으로 바뀌었다**(옛 주석은 56/30).
; 높이 116 = 시트 높이의 0.91배(옛 60도 64의 0.94배였다 — 같은 비율). 꼭대기 ~12px을 뺀 건 거기까지
; 가면 플레이어(56px) 몸이 나무 **위로** 올라가 실제 겹침이 사실상 0이라서다.
; 🔴 값의 정본은 **접지선**이다(세 컷 전부 row 122) — 그림을 다시 그리면 여기 셋이 같이 움직인다.
[sub_resource type="RectangleShape2D" id="RectangleShape2D_behind"]
size = Vector2(88, 116)

[node name="Tree" type="Sprite2D"]
; offset.y = -(접지선 122 − 프레임높이/2 64) = -58. 밑동이 노드 원점에 오게 하는 값이다.
offset = Vector2(0, -58)
script = ExtResource("1_tree")

; 🔴🔴 **`collision_layer = 0`이 계약이다** — 나무는 감지만 하고 **아무에게도 안 잡힌다.**
; 레이어를 채우면 boss_room.gd 머리말이 경고한 그 함정(캐리어가 나무마다 터진다)이 되살아난다.
; `monitorable = false`도 같은 이유(다른 Area2D가 이 나무를 주우면 드롭·피격 판정에 섞인다).
; mask 2 = 플레이어. 🔴 적까지 넓히려면 여기에 4(enemy)를 더해라 — tree.gd는 이미 여럿을 센다.
[node name="BehindSense" type="Area2D" parent="."]
; y = -58 = 상자 위끝 −116 · 아래끝 0 의 중점. 🔴 **아래끝이 접지선(원점)과 같아야 한다** —
; 아래로 내려가면 나무 **앞**에 선 플레이어까지 비침이 걸려 "둥지·나무가 앞으로 튀어나온다"가 된다.
; ⚠ offset.y와 우연히 같은 값(−58)이지 베낀 게 아니다 — 산식이 다르다(위 주석 둘).
position = Vector2(0, -58)
collision_layer = 0
collision_mask = 2
monitorable = false

[node name="CollisionShape2D" type="CollisionShape2D" parent="BehindSense"]
shape = SubResource("RectangleShape2D_behind")
