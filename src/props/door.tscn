[gd_scene load_steps=3 format=3]

; 🔴🔴 **방 출구 문** (세112 단계 5 · R6). 🔴 **새 스크립트가 0이다** — `interact_zone.gd`가
; 책상·출구·상자 열기와 **같은 물건**이고(그 파일 머리말), 문에 필요한 것도 그것뿐이다:
; 가까이 오면 안내를 띄우고 [E]에 `interacted`를 쏜다. 문 셋을 가르는 것은 **씬이 아니라 배선**이다
; (`boss_room._spawn_doors`가 문마다 다른 보상을 물린다).
;
; 🔴 **`zone_id`가 `&"exit"`이 아닌 것이 계약이다** — `test_chapter_auto`가 `&"exit"`을 세어
; 「`_extract`에 이어진 수」와 대조하므로, 문에 그 값을 주면 **나가는 길이 넷으로 집계돼** 빨개진다
; (`chest.tscn`의 `&"landmark"`가 같은 이유로 갈려 있다 — `interact_zone.gd`의 열거 참조).
;
; 🔴 **물리 = layer 64(interaction) / mask 2(player)** — 1(world)에 두면 캐리어가 여기 부딪혀 마법이 죽는다.
; ⚠ 그림이 **아직 없다**(단계 7 아트 · `takbon-artref` 선행). 🔴 도형으로 때우지 않았다 —
;  지금 화면에 보이는 것은 **글자 둘**이고, 설계 §7이 그걸 명시로 허락했다(*"글자는 도형 스탠드인이 아니다"*).
;  ⚠ 씬 .tscn 주석은 에디터 저장 시 날아간다 — 이 설명의 정본은 `boss_room.gd`의 `_spawn_doors`.

[ext_resource type="Script" path="res://src/actors/interact_zone.gd" id="1_zone"]

[sub_resource type="RectangleShape2D" id="RectangleShape2D_door"]
; 씬의 남쪽 `$Exit`와 같은 치수 — 문은 「같은 물건 셋」으로 읽혀야 한다(설계 §8).
size = Vector2(120, 70)

[node name="Door" type="Area2D"]
collision_layer = 64
collision_mask = 2
script = ExtResource("1_zone")
zone_id = &"door"

[node name="CollisionShape2D" type="CollisionShape2D" parent="."]
shape = SubResource("RectangleShape2D_door")

; [E] 안내 — `interact_zone`이 범위에 들어올 때만 켠다(`_ready`가 꺼 두고 `_on_body_entered`가 켠다).
[node name="Prompt" type="Label" parent="."]
offset_left = -80.0
offset_top = -78.0
offset_right = 80.0
offset_bottom = -56.0
text = "[E] 들어간다"
horizontal_alignment = 1

; 🔴🔴 **보상 미리보기 — 늘 보인다**(`Prompt`와 다른 점이 이것이다). 문 앞까지 가야 보이면
; **고르는 근거가 없어져** 문 고르기가 통째로 무의미해진다(`genre_pivot` D4의 심장).
; 🔴 문구는 `boss_room._spawn_doors`가 **데이터에서** 채운다(`LandmarkDef.title`) — 여기 박으면 거짓말이 된다.
[node name="Reward" type="Label" parent="."]
offset_left = -80.0
offset_top = -104.0
offset_right = 80.0
offset_bottom = -82.0
text = ""
horizontal_alignment = 1
