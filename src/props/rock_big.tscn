[gd_scene load_steps=2 format=3]

[ext_resource type="Texture2D" path="res://assets/sprites/field/rock_big.png" id="1_tex"]

; 🔴🔴 **장식이다 — 물리 몸도 감지 Area도 없다.**
;  ⓐ `StaticBody2D`를 붙이면 world 레이어라 마법 캐리어(마스크 5)가 **바위마다 터진다**
;    (`boss_room.gd` 머리말의 그 함정 — 나무가 장식인 이유와 같다).
;  ⓑ 나무의 「뒤로 가면 비친다」(`BehindSense`)를 **복사하지 마라**: 바위는 화면 키 64px이라
;    플레이어(56px)를 거의 안 가려서 아무 일도 안 하는 **거짓 손잡이**가 된다(감사 T3).
;    덤불(42px)·작은 돌(18px)은 더하다. 그 기능은 **나무만** 가진다.
;
; 🔴 **원점 = 접지선**이다 — `offset.y = -(접지선 56 − 프레임높이/2 32) = -24`.
;  프롭 자리(`boss_room._spawn_props`)·흙길 회피가 전부 이 원점에서 파생하므로, 그림을 다시 그려
;  접지선이 움직이면 **여기 한 줄만** 고친다. 그물 = `test_prop_layout_auto [7]`(프레임·offset 대조).
; ⚠ 그림은 접지선 **아래로도 7px 더 간다**(row 57~63 = 바닥에 깔린 그림자). 뜬 게 아니다.
; ⚠ 이 `;` 주석은 에디터가 이 파일을 저장하면 증발한다(takbon-rules §5) — 계약의 정본은
;  `boss_room.gd`의 `PROP_TABLE` 머리말과 위 그물이다.
[node name="RockBig" type="Sprite2D"]
texture = ExtResource("1_tex")
offset = Vector2(0, -24)
