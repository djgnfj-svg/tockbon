# Godot 캐시
.godot/

# 엔진 바이너리 (172MB — 커밋 금지)
Godot_v*.exe

# 임시
*.tmp

# 🔴 에이전트 일회성 보고서 (리드가 읽고 지운다 — 리포에 안 남긴다).
# gitignore가 없으면 `git add -A` 한 번에 영구 커밋된다.
docs/_reports/

# 임시 스크린샷 등 루트 이미지
/image.png
/image.png.import

# 🔴 도구가 뽑는 임시 격자·비교 스샷.
# PNG마다 .import 사이드카가 딸려 `git add -A` 한 번이면 통째로 커밋된다.
scratch_shots/

# 🔴 아트 레퍼런스. 남의 그림이라 **라이선스가 불명**이다 — 리포에 커밋하면 안 된다.
# ⚠ 이미지는 사라져도 되게 **검색 URL을 보고서·설계문서에 텍스트로 남겨라**(그러면 다시 뽑는다).
docs/_refs/

# 🔴 파이썬 바이트코드 — `tools/`의 생성기끼리 서로 import하면 생긴다.
# 돌릴 때마다 다시 생기므로 안 막으면 워킹트리에 상시 잡음으로 남는다.
__pycache__/
*.pyc
