[resource]
script = ExtResource("1")
id = &"q02_come_home"
title = "살아 돌아와라"
; 🔴 세112 R1: 옛 문구가 **두 가지를 거짓으로** 가르치고 있었다 — *"출구는 여러 곳에"*(하나다) ·
;  *"[E]를 꾹 눌러 버텨야"*(홀드가 폐기돼 한 번이다). 그물이 desc를 안 물어 **조용히 거짓말했고
;  스샷이 잡았다.** ⚠ 조작을 문구에 적을 땐 정본이 `project.godot`의 액션임을 잊지 마라.
desc = "되찾은 것을 들고 살아서 나와라. 남쪽 출구에서 [E]."
