position = Vector2(620, -900)

; 🔴 대역은 후보가 하나여도 남겨 둔다 — 새 몹이 대역을 골라 한 줄로 들어오는 자리다(ch1과 같은 결).
[sub_resource type="Resource" id="w_fore_hound"]
script = ExtResource("3")
enemy_id = &"hound"
weight = 1
pool_tag = &"fore"

[sub_resource type="Resource" id="w_deep_hound"]
script = ExtResource("3")
enemy_id = &"hound"
weight = 1
pool_tag = &"deep"

; 🔴🔴 세112 R8: **네임드 자리를 비웠다** — 근거·되살리는 법은 `ch1.tres`의 같은 자리에 적었다.
;  🔴 되살릴 때 쓸 세99 값: `enemy_id=&"hound_alpha"` · `chance=0.3` · `position=Vector2(-700, -600)`.
[resource]
script = ExtResource("1")
id = &"ch3"
order = 3
title = "깊은 숲"
boss_enemy_id = &"snake_boss"
boss_scene_path = "res://src/field/snake_boss.tscn"
boss_spawn = Vector2(0, -1350)
room_ground_color = Color(0.22, 0.31, 0.23, 1.0)
mob_spawns = Array[ExtResource("2")]([SubResource("mob1"), SubResource("mob2"), SubResource("mob3"), SubResource("mob6"), SubResource("mob7"), SubResource("mob10"), SubResource("mob11"), SubResource("mob12"), SubResource("mob13")])
reward_unlock = &"rune_grass"
mob_pool = Array[ExtResource("3")]([SubResource("w_fore_hound"), SubResource("w_deep_hound")])
named_pool = Array[ExtResource("4")]([])
; 🔴 세112 R1: 탈출구 여럿을 걷었다 — 근거는 `ch1.tres`의 같은 자리(한 벌만 든다).
extract_points = Array[Vector2]([])
