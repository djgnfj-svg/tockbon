[gd_resource type="Resource" script_class="ChapterDef" load_steps=14 format=3]

[ext_resource type="Script" path="res://src/core/schemas/chapter_def.gd" id="1"]
[ext_resource type="Script" path="res://src/core/schemas/mob_spawn.gd" id="2"]
[ext_resource type="Script" path="res://src/core/schemas/mob_weight.gd" id="3"]
[ext_resource type="Script" path="res://src/core/schemas/named_spawn.gd" id="4"]

; 🐺 세99: 잡몹이 **늑대 하나**로 줄었다 (`data/enemies/README.md`).
; 🔴 **좌표는 세98 배치 그대로다** — 자리는 지형이 정한 것이라 몹이 바뀌어도 안 옮긴다.
;  11자리 중 **일곱만** 남겼다: 늑대는 지금까지 여기 서던 것들보다 세다(HP 26 · 접촉 8 · 돌진 330 ·
;  aggro 220). 열한 자리를 그대로 늑대로 채우면 남쪽 어귀에서만 다섯이 동시에 붙는다.
;  ⚠ 지운 넷 (-650,250)·(600,200)·(-620,-180)·(640,-250)은 **자리를 접은 것**이지 좌표가 틀린 게
;   아니다 — 몹이 늘면 되살릴 후보다(그때는 `pool_tag`로 돌려 쓰는 편이 낫다).
[sub_resource type="Resource" id="mob1"]
script = ExtResource("2")
position = Vector2(-420, 480)
pool_tag = &"fore"

[sub_resource type="Resource" id="mob2"]
script = ExtResource("2")
position = Vector2(380, 350)
pool_tag = &"fore"

[sub_resource type="Resource" id="mob3"]
script = ExtResource("2")
enemy_id = &"hound"
position = Vector2(0, 400)

[sub_resource type="Resource" id="mob6"]
script = ExtResource("2")
position = Vector2(-300, -300)
pool_tag = &"deep"

[sub_resource type="Resource" id="mob7"]
script = ExtResource("2")
position = Vector2(350, -450)
pool_tag = &"deep"

[sub_resource type="Resource" id="mob10"]
script = ExtResource("2")
enemy_id = &"hound"
position = Vector2(-280, -1000)

[sub_resource type="Resource" id="mob11"]
script = ExtResource("2")
enemy_id = &"hound"
position = Vector2(300, -1100)

; 🔴 대역은 후보가 하나여도 남겨 둔다 — 새 몹이 대역을 골라 한 줄로 들어오는 자리다(ch1과 같은 결).
[sub_resource type="Resource" id="w_fore_hound"]
script = ExtResource("3")
enemy_id = &"hound"
weight = 1
pool_tag = &"fore"

[sub_resource type="Resource" id="w_deep_hound"]
script = ExtResource("3")
enemy_id = &"hound"
weight = 1
pool_tag = &"deep"

; 🔴🔴 세112 R8: **네임드 자리를 비웠다** — 근거·되살리는 법은 `ch1.tres`의 같은 자리에 적었다
;  (한 벌만 든다 — 세 파일에 같은 설명을 베끼면 갈라진다). 🔴 되살릴 때 쓸 세99 값:
;  `enemy_id=&"hound_alpha"` · `chance=0.3` · `position=Vector2(650, -700)`.
[resource]
script = ExtResource("1")
id = &"ch2"
order = 2
title = "바람 드는 곳"
boss_enemy_id = &"gale"
boss_scene_path = ""
boss_spawn = Vector2(0, -1350)
room_ground_color = Color(0.28, 0.38, 0.33, 1.0)
mob_spawns = Array[ExtResource("2")]([SubResource("mob1"), SubResource("mob2"), SubResource("mob3"), SubResource("mob6"), SubResource("mob7"), SubResource("mob10"), SubResource("mob11")])
reward_unlock = &"rune_wind"
mob_pool = Array[ExtResource("3")]([SubResource("w_fore_hound"), SubResource("w_deep_hound")])
named_pool = Array[ExtResource("4")]([])
; 🔴 세112 R1: 탈출구 여럿을 걷었다 — 근거는 `ch1.tres`의 같은 자리(한 벌만 든다).
extract_points = Array[Vector2]([])
