[sub_resource type="Resource" id="named_beetle"]
script = ExtResource("4")
enemy_id = &"beetle_ancient"
chance = 0.3
position = Vector2(-600, -700)

; 🪦 지점 하나 — 늑대 둥지 (세99 D3·D4 단계 3).
; 🔴 **자리를 이렇게 고른 이유**(옮길 땐 넷을 같이 봐야 한다):
;  ⓐ 입구(0,+600)에서 걸어갈 만하다 — 흙길 길이 900px(북) + 620px(동) ≈ 8초. 보스(0,-1350)보다
;    확실히 가깝고, 「가는 길에 지나치는 것」이 아니라 **일부러 들르는 것**이 되게 옆으로 뺐다.
;  ⓑ 나무·다른 잡몹·보스 스폰과 안 겹친다(가장 가까운 나무 (500,-740)까지 450px).
;  ⓒ 서쪽 탈출구(-1150,-360)의 흙길과 **안 닿는다** — 붙이면 두 길이 한 칸 띄고 나란히 달려
;    「잘못 깐 바닥」으로 읽힌다(마을 바닥을 둘로 나눴다 튄 자리와 같은 병 — takbon-rules §2).
;  ⓓ 둥지 스프라이트는 원점 위로 140px 솟는다(178×121) — 위쪽에 여유가 있어야 잘리지 않는다.
[sub_resource type="Resource" id="lm_nest_slot"]
