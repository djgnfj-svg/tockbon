mob_spawns = Array[ExtResource("2")]([SubResource("mob1"), SubResource("mob2"), SubResource("mob3"), SubResource("mob4"), SubResource("mob5"), SubResource("mob6"), SubResource("mob7"), SubResource("mob8"), SubResource("mob9"), SubResource("mob_wolf1"), SubResource("mob_wolf2"), SubResource("mob_wolf3"), SubResource("mob_wolf4"), SubResource("mob_wolf5")])
reward_unlock = &"rune_water"
mob_pool = Array[ExtResource("3")]([SubResource("w_fore_slime"), SubResource("w_fore_mist"), SubResource("w_deep_mist"), SubResource("w_deep_beetle"), SubResource("w_deep_slime")])
named_pool = Array[ExtResource("4")]([SubResource("named_beetle")])
extract_points = Array[Vector2]([Vector2(-1150, -360), Vector2(300, -1400)])
landmarks = Array[ExtResource("5")]([SubResource("lm_nest_slot")])
