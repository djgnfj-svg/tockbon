; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="tockbon"
run/main_scene="res://src/menu/title.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

MCPGameBridge="res://addons/godot_mcp/game_bridge/mcp_game_bridge.gd"
EventBus="*res://src/core/event_bus.gd"
GameState="*res://src/core/game_state.gd"
Clock="*res://src/core/clock.gd"
Db="*res://src/core/db.gd"
SaveManager="*res://src/core/save_manager.gd"
Audio="*res://src/core/audio.gd"

[display]

window/size/viewport_width=960
window/size/viewport_height=540
window/size/window_width_override=1920
window/size/window_height_override=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_mcp/plugin.cfg")

[godot_mcp]

bind_mode=0
custom_bind_ip=""
port_override_enabled=false
port_override=6550

